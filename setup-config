"""Interactive configuration tool for the workstation setup playbook.

Dependencies are declared inline with PEP 723; `uv` provisions them when the
script is run directly. Use `./setup-config` or `uv run --script setup-config`.
"""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Dict, Iterable, List, Mapping, Optional, Sequence, Tuple

REPO_ROOT = Path(__file__).resolve().parent
DEFAULT_CONFIG = REPO_ROOT / "default.config.yml"
MENU_FILE = REPO_ROOT / "setup-config-menu.json"
PREFERENCES = Path.home() / ".setup-options"

KEY_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*):(?:\s*(.*))?$")
HOME_FORMULA_RE = re.compile(r"\{\{\s*lookup\('env',\s*'HOME'\)\s*\}\}")


class ToolError(Exception):
    """User-facing setup-config error."""


@dataclass(frozen=True)
class ListItem:
    value: str
    comment: Optional[str] = None


@dataclass(frozen=True)
class UnsupportedValue:
    raw: str


@dataclass
class Block:
    key: Optional[str]
    lines: List[str]


@dataclass(frozen=True)
class MenuItem:
    key: str
    label: str
    summary: str
    kind: str
    requires: Optional[str] = None
    lists: Tuple[str, ...] = ()
    extras: Tuple[str, ...] = ()
    removals: Tuple[str, ...] = ()


@dataclass(frozen=True)
class Category:
    id: str
    label: str
    items: Tuple[MenuItem, ...]


@dataclass(frozen=True)
class Menu:
    categories: Tuple[Category, ...]
    package_keys: Tuple[str, ...]


class ConfigError(ToolError):
    """Error during config file operations."""


PREFERENCES_HEADER = (
    "# Local overrides for the workstation setup playbook.\n"
    "# Managed by setup-config; unmanaged keys are preserved.\n"
)


def _render_key_lines(key: str, value) -> List[str]:
    """Render a key-value pair as YAML lines."""
    if isinstance(value, bool):
        return [f"{key}: {'true' if value else 'false'}"]
    if value == "ignore":
        return [f"{key}: ignore"]
    if isinstance(value, list):
        lines = [f"{key}:"]
        for item in value:
            if isinstance(item, ListItem):
                comment = f" # {item.comment}" if item.comment else ""
                lines.append(f"  - {item.value}{comment}")
            else:
                # Simple string item
                try:
                    import json as _json
                    dumped = _json.dumps(item)
                    if dumped.startswith('"') and dumped.endswith('"'):
                        # It's a simple string, use as-is
                        lines.append(f"  - {item}")
                    else:
                        lines.append(f"  - {item}")
                except (TypeError, ValueError):
                    lines.append(f"  - {item}")
        return lines
    if isinstance(value, str):
        return [f"{key}: {json.dumps(value)}"]
    raise ConfigError(f"{key}: unsupported value type")


def update_preferences_text(text: str, desired: Mapping[str, object],
                             remove: Iterable[str]) -> str:
    """Return text with only the desired top-level keys replaced/added/removed."""
    remove_set = set(remove)
    desired_keys = set(desired.keys())
    blocks = split_blocks(text)
    output_lines: List[str] = []
    handled_keys: set = set()

    for block in blocks:
        if block.key is None:
            # Trivia block: copy verbatim
            output_lines.extend(block.lines)
            continue
        key = block.key
        if key in remove_set:
            # Skip removed keys
            handled_keys.add(key)
            continue
        if key in desired_keys:
            # Replace with rendered lines
            output_lines.extend(_render_key_lines(key, desired[key]))
            handled_keys.add(key)
            continue
        # Unknown or unchanged key: copy verbatim
        output_lines.extend(block.lines)

    # Append any desired keys not handled
    for key in desired_keys:
        if key not in handled_keys:
            if output_lines and output_lines[-1].strip() != '':
                output_lines.append('')
            output_lines.extend(_render_key_lines(key, desired[key]))

    # Join, strip trailing blank lines, end with exactly one newline
    result = '\n'.join(output_lines)
    result = re.sub(r'\n+[ \t]*$', '\n', result)
    if not result.endswith('\n'):
        result += '\n'
    return result


def write_preferences(path: Path, new_text: str, old_text: str) -> None:
    """Write text to path atomically, creating .bak from old content."""
    if old_text and path.exists():
        bak_path = path.with_name(path.name + ".bak")
        try:
            import shutil as _shutil
            _shutil.copy2(str(path), str(bak_path))
        except OSError:
            pass  # .bak is best-effort

    path.parent.mkdir(parents=True, exist_ok=True)
    mode = 0o644
    if path.exists():
        import stat as _stat
        mode = _stat.S_IMODE(path.stat().st_mode)

    import tempfile as _tempfile
    import os as _os
    fd, tmp = _tempfile.mkstemp(dir=str(path.parent), prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, 'w') as f:
            f.write(new_text)
            f.flush()
            _os.fsync(f.fileno())
        _os.chmod(tmp, mode)
        _os.replace(tmp, str(path))
    except Exception as exc:
        try:
            _os.unlink(tmp)
        except OSError:
            pass
        raise ConfigError(f"could not write {path}: {exc}")


class Config:
    """Manages ~/.setup-options with minimal-override writes."""

    def __init__(self, defaults_path: Path, prefs_path: Path,
                 package_keys: Sequence[str],
                 tristate_keys: Sequence[str] = ()):
        self._defaults_path = defaults_path
        self._prefs_path = prefs_path
        self._package_keys = tuple(package_keys)
        self._tristate_keys = set(tristate_keys)
        self._defaults: Dict[str, object] = {}
        self._overrides: Dict[str, object] = {}
        self._prefs_text: str = ""
        self.reload()

    def reload(self) -> None:
        """Reload defaults and current overrides from disk."""
        if not self._defaults_path.exists():
            raise ConfigError(f"default config not found: {self._defaults_path}")
        try:
            self._defaults = parse_yaml_subset(self._defaults_path.read_text())
        except Exception as e:
            raise ConfigError(f"could not read defaults: {e}")
        if self._prefs_path.exists():
            try:
                self._prefs_text = self._prefs_path.read_text()
            except OSError as e:
                raise ConfigError(f"could not read preferences: {e}")
        else:
            self._prefs_text = ""
        self._overrides = {}
        if self._prefs_text:
            prefs_data = parse_yaml_subset(self._prefs_text)
            for key in self._defaults:
                if key in prefs_data:
                    self._overrides[key] = prefs_data[key]

    def effective(self, key: str) -> object:
        """Return the effective value for a key (override or default)."""
        if key in self._overrides:
            return self._overrides[key]
        return self._defaults.get(key)

    def source(self, key: str) -> str:
        """Return 'override' or 'default'."""
        return "override" if key in self._overrides else "default"

    def set(self, key: str, value) -> bool:
        """Set a key to a value. Returns True if the file changed."""
        # Validate key exists in defaults
        if key not in self._defaults:
            raise ConfigError(f"unknown key: {key}")
        # Check effective value is not UnsupportedValue
        eff = self.effective(key)
        if isinstance(eff, UnsupportedValue):
            raise ConfigError(f"key '{key}' has unsupported value, cannot edit")
        # Check new value is not UnsupportedValue
        if isinstance(value, UnsupportedValue):
            raise ConfigError(f"cannot set key '{key}' to unsupported value")
        # Type validation based on default value and tristate_keys
        default_val = self._defaults[key]
        if key in self._tristate_keys:
            if not (isinstance(value, bool) or value == "ignore"):
                raise ConfigError(f"tristate key '{key}': expected bool or 'ignore'")
        elif isinstance(default_val, bool):
            if not isinstance(value, bool):
                raise ConfigError(f"bool key '{key}': expected bool")
        elif isinstance(default_val, str):
            if not isinstance(value, str):
                raise ConfigError(f"string key '{key}': expected str")

        # Check if value equals current effective value
        if value == eff:
            return False

        # Compute desired overrides
        default_val = self._defaults[key]
        to_set: Dict[str, object] = {}
        to_remove: List[str] = []

        if value == default_val:
            # Returning to default: remove the override
            to_remove = [key]
        else:
            to_set = {key: value}

        # Compute new text
        new_text = update_preferences_text(self._prefs_text, to_set, to_remove)

        # Check if text actually changed
        if new_text == self._prefs_text:
            return False

        # Prepend header if file is new
        if not self._prefs_text.strip():
            new_text = PREFERENCES_HEADER + new_text

        # Write
        write_preferences(self._prefs_path, new_text, self._prefs_text)
        self._prefs_text = new_text
        # Update overrides
        if to_set:
            self._overrides[key] = to_set[key]
        if to_remove and key in self._overrides:
            del self._overrides[key]

        return True

    def reset(self, key: str) -> bool:
        """Reset a key to its default value. Returns True if file changed."""
        if key not in self._overrides:
            return False
        to_remove = [key]
        new_text = update_preferences_text(self._prefs_text, {}, to_remove)
        if new_text == self._prefs_text:
            return False
        if not self._prefs_text.strip():
            new_text = PREFERENCES_HEADER + new_text
        write_preferences(self._prefs_path, new_text, self._prefs_text)
        self._prefs_text = new_text
        del self._overrides[key]
        return True

    def package_overrides(self) -> List[Tuple[str, object]]:
        """Return list of (key, value) for package key overrides."""
        return [(k, self._overrides[k]) for k in self._package_keys if k in self._overrides]

    def clear_package_overrides(self) -> List[str]:
        """Remove all package key overrides in one write. Returns removed key names."""
        keys_to_remove = [k for k in self._package_keys if k in self._overrides]
        if not keys_to_remove:
            return []
        new_text = update_preferences_text(self._prefs_text, {}, keys_to_remove)
        write_preferences(self._prefs_path, new_text, self._prefs_text)
        self._prefs_text = new_text
        for k in keys_to_remove:
            self._overrides.pop(k, None)
        return keys_to_remove

    def unsupported_keys(self) -> List[str]:
        """Return sorted keys whose effective value is UnsupportedValue."""
        result = []
        for key in sorted(self._defaults.keys()):
            eff = self.effective(key)
            if isinstance(eff, UnsupportedValue):
                result.append(key)
        return result

    @property
    def defaults(self) -> Dict[str, object]:
        """Expose defaults for external use."""
        return self._defaults


def split_blocks(text: str) -> List[Block]:
    """Split text into key blocks and trivia (blank/comment) blocks."""
    # Strip trailing newline to avoid spurious empty block at end
    text = text.rstrip('\n')
    blocks: List[Block] = []
    current_block: Optional[Block] = None
    current_is_trivia = False

    for line in text.split('\n'):
        # Check for a top-level key line (column 0, valid key name, colon)
        m = KEY_RE.match(line)
        if m and not line[0].isspace():
            # Save previous block and start a new key block
            if current_block is not None:
                blocks.append(current_block)
            current_block = Block(key=m.group(1), lines=[line])
            current_is_trivia = False
            continue

        is_blank = line == ''
        is_comment = line.startswith('#') and not line[0].isspace() and line.strip()

        if is_blank:
            if current_block is None:
                continue  # Skip leading blank lines
            if current_is_trivia:
                current_block.lines.append(line)
            else:
                blocks.append(current_block)
                current_block = Block(key=None, lines=[line])
                current_is_trivia = True
            continue

        if is_comment:
            if current_block is None:
                # First line is a comment: start trivia block
                current_block = Block(key=None, lines=[line])
                current_is_trivia = True
            elif current_is_trivia:
                current_block.lines.append(line)
            else:
                blocks.append(current_block)
                current_block = Block(key=None, lines=[line])
                current_is_trivia = True
            continue

        # Indented line: add to current block
        if line.startswith(' ') or line.startswith('\t'):
            if current_block is not None:
                current_block.lines.append(line)
            continue

        # Unknown line: add to current block
        if current_block is not None:
            current_block.lines.append(line)

    if current_block is not None:
        blocks.append(current_block)

    return blocks


def _strip_inline_comment(value: str) -> str:
    """Strip inline # comment only when # is outside quotes and preceded by whitespace."""
    in_quote = False
    quote_char = None
    for i, ch in enumerate(value):
        if in_quote:
            if ch == quote_char:
                in_quote = False
        else:
            if ch in ('"', "'"):
                in_quote = True
                quote_char = ch
            elif ch == '#' and i > 0 and value[i - 1] == ' ':
                return value[:i].rstrip()
    return value


def _parse_scalar(raw: str):
    """Parse a scalar YAML value."""
    raw = raw.strip()
    if not raw:
        return None
    # Quoted string
    if (raw.startswith('"') and raw.endswith('"')) or \
       (raw.startswith("'") and raw.endswith("'")):
        return raw[1:-1]
    # Boolean
    if raw == 'true':
        return True
    if raw == 'false':
        return False
    # Null
    if raw in ('null', '~'):
        return None
    # Strip inline comments
    raw = _strip_inline_comment(raw)
    raw = raw.strip()
    # Keep as string
    return raw


def _parse_flow_list(text: str):
    """Parse a flow list like [a, b] or []. Returns List[ListItem]."""
    inner = text.strip().strip('[]').strip()
    if not inner:
        return []
    items = [s.strip() for s in inner.split(',')]
    return [ListItem(value=item, comment=None) for item in items]


def _parse_block_list(lines: List[str]):
    """Parse block-style list lines (starting with '  - ')."""
    items = []
    for line in lines[1:]:  # skip the key line itself
        line = line.strip()
        if line.startswith('- '):
            item_text = line[2:].strip()
            comment = None
            # Check for inline comment
            comment_match = re.search(r'\s+#\s+(.+)$', item_text)
            if comment_match:
                comment = comment_match.group(1).strip()
                item_text = item_text[:comment_match.start()].strip()
            items.append(ListItem(value=item_text, comment=comment))
        elif line.startswith('-'):
            # Empty list item marker
            pass
    return items


def parse_yaml_subset(text: str) -> Dict[str, object]:
    """Parse a YAML subset into a dictionary of values."""
    blocks = split_blocks(text)
    result: Dict[str, object] = {}

    for block in blocks:
        if block.key is None:
            # Trivia block, skip
            continue

        key = block.key
        lines = block.lines

        # First line is the key line: "key: value" or "key:"
        first_line = lines[0]
        m = KEY_RE.match(first_line)
        if not m:
            continue

        value_part = m.group(2) if m.group(2) is not None else ''
        value_part = value_part.strip()

        # Check for flow list on the key line
        if value_part.startswith('['):
            result[key] = _parse_flow_list(value_part)
            continue

        # Empty value part: could be a block list or unsupported
        if not value_part:
            continuation_lines = lines[1:]
            if continuation_lines and all(
                cl.strip().startswith('- ') or cl.strip() == '-' for cl in continuation_lines
            ):
                # Block-style list
                result[key] = _parse_block_list(lines)
            else:
                # Unsupported nested mapping
                raw_text = '\n'.join(block.lines)
                result[key] = UnsupportedValue(raw_text)
            continue

        # Non-empty value part: scalar
        value_part = _strip_inline_comment(value_part)
        result[key] = _parse_scalar(value_part)

    return result


def load_menu(path: Path, defaults: Mapping[str, object]) -> Menu:
    """Load menu from JSON file and validate against defaults."""
    try:
        with open(path, 'r') as f:
            data = json.load(f)
    except (json.JSONDecodeError, KeyError, TypeError) as e:
        raise ToolError(f"{path}: malformed menu metadata — {e}")

    categories = []
    for cat_data in data.get("categories", []):
        items = []
        for item_data in cat_data.get("items", []):
            item = MenuItem(
                key=item_data["key"],
                label=item_data.get("label", item_data["key"]),
                summary=item_data.get("summary", ""),
                kind=item_data.get("type", "bool"),
                requires=item_data.get("requires"),
                lists=tuple(item_data.get("lists", [])),
                extras=tuple(item_data.get("extras", [])),
                removals=tuple(item_data.get("removals", [])),
            )
            items.append(item)
        cat = Category(
            id=cat_data["id"],
            label=cat_data.get("label", cat_data["id"]),
            items=tuple(items),
        )
        categories.append(cat)

    package_keys = tuple(data.get("package_keys", []))
    menu = Menu(categories=tuple(categories), package_keys=package_keys)

    errors = validate_menu(menu, defaults)
    if errors:
        raise ToolError("\n".join(errors))

    return menu


def validate_menu(menu: Menu, defaults: Mapping[str, object]) -> List[str]:
    """Validate menu structure against defaults. Returns list of error strings."""
    errors: List[str] = []

    # Check at least one category exists
    if not menu.categories:
        errors.append("menu has no categories")
        return errors

    # Check category ids are unique
    cat_ids = [c.id for c in menu.categories]
    seen_cat_ids = set()
    for cid in cat_ids:
        if cid in seen_cat_ids:
            errors.append(f"duplicate category id: {cid}")
        seen_cat_ids.add(cid)

    # Check every category has at least one item
    for cat in menu.categories:
        if not cat.items:
            errors.append(f"category '{cat.id}' has no items")

    # Check item keys are unique and exist in defaults
    seen_item_keys = set()
    for cat in menu.categories:
        for item in cat.items:
            if item.key in seen_item_keys:
                errors.append(f"duplicate item key: {item.key}")
            seen_item_keys.add(item.key)
            if item.key not in defaults:
                errors.append(f"unknown key in menu: {item.key}")

    # Check kind values
    valid_kinds = {"tristate", "bool", "string"}
    for cat in menu.categories:
        for item in cat.items:
            if item.kind not in valid_kinds:
                errors.append(f"item '{item.key}': invalid kind '{item.kind}'")
            # Check default value matches kind
            if item.key in defaults:
                val = defaults[item.key]
                if item.kind == "bool":
                    if not isinstance(val, bool):
                        errors.append(f"item '{item.key}': type mismatch, expected bool")
                elif item.kind == "string":
                    if not isinstance(val, str):
                        errors.append(f"item '{item.key}': type mismatch, expected str")
                elif item.kind == "tristate":
                    if not (isinstance(val, bool) or val == "ignore" or val is None):
                        errors.append(f"item '{item.key}': type mismatch, expected bool or 'ignore'")

    # Check requires values
    valid_requires = {None, "homebrew", "apt", "darwin"}
    for cat in menu.categories:
        for item in cat.items:
            if item.requires not in valid_requires:
                errors.append(f"item '{item.key}': invalid requires '{item.requires}'")

    # Check lists, extras, removals are arrays of strings
    for cat in menu.categories:
        for item in cat.items:
            if not isinstance(item.lists, (tuple, list)):
                errors.append(f"item '{item.key}': 'lists' must be an array")
            if not isinstance(item.extras, (tuple, list)):
                errors.append(f"item '{item.key}': 'extras' must be an array")
            if not isinstance(item.removals, (tuple, list)):
                errors.append(f"item '{item.key}': 'removals' must be an array")

    # Check package_keys entries exist in defaults and are lists
    for pk in menu.package_keys:
        if pk not in defaults:
            errors.append(f"package_keys entry '{pk}' not in defaults")
        else:
            val = defaults[pk]
            if not isinstance(val, list):
                errors.append(f"package_keys entry '{pk}' is not a list in defaults")

    # Check every lists key is in package_keys and is a list in defaults
    for cat in menu.categories:
        for item in cat.items:
            for lk in item.lists:
                if lk not in menu.package_keys:
                    errors.append(f"item '{item.key}': list key '{lk}' not in package_keys")
                elif lk in defaults:
                    if not isinstance(defaults[lk], list):
                        errors.append(f"item '{item.key}': list key '{lk}' is not a list in defaults")

    # Check agent_python_packages, install_mas_apps, remove_mas_apps are in package_keys
    required_package_keys = {"agent_python_packages", "install_mas_apps", "remove_mas_apps"}
    for rpk in required_package_keys:
        if rpk not in menu.package_keys:
            errors.append(f"required package key '{rpk}' not in package_keys")

    return errors


def build_apply_command(executable: str, *, ask_become_pass: bool = False) -> List[str]:
    """Build the ansible-playbook command list."""
    command = [executable, "-i", "localhost,", "-c", "local"]
    if ask_become_pass:
        command.append("--ask-become-pass")
    command.append("main.yml")
    return command


def find_ansible_playbook(which=shutil.which, is_executable=os.access) -> Optional[str]:
    """Find the ansible-playbook executable."""
    path = which("ansible-playbook")
    if path:
        return path
    candidates = [
        "/opt/homebrew/bin/ansible-playbook",
        "/usr/local/bin/ansible-playbook",
        "/usr/bin/ansible-playbook",
        "/home/linuxbrew/.linuxbrew/bin/ansible-playbook",
    ]
    for c in candidates:
        if is_executable(c, os.X_OK):
            return c
    return None


def become_prompt_required(apt_available: bool) -> bool:
    """Only apt tasks need root; Homebrew formulae and casks do not."""
    return bool(apt_available)


def become_choice_confirmed(answer: object) -> bool:
    """Treat prompt_toolkit's answer as opt-in: True only, so Ctrl-C (None) is No."""
    return answer is True


def apply_playbook(repo_root: Path, *, runner=None, which=shutil.which,
                   is_executable=os.access, out=None,
                   ask_become_pass: bool = False) -> int:
    """Run the ansible playbook. Returns exit code."""
    if out is None:
        out = print

    # Check for main.yml
    if not (repo_root / "main.yml").is_file():
        out(f"setup-config: main.yml not found in {repo_root}")
        return 1

    # Find ansible-playbook
    ansible_path = find_ansible_playbook(which, is_executable)
    if not ansible_path:
        out("setup-config: ansible-playbook not found. "
           "Install it or ensure it is on PATH.")
        return 127

    cmd = build_apply_command(ansible_path, ask_become_pass=ask_become_pass)
    out(f"Running: {' '.join(cmd)}")
    out(f"Directory: {repo_root}")

    if runner is None:
        try:
            result = subprocess.run(cmd, cwd=str(repo_root), check=False)
            return result.returncode
        except OSError as exc:
            out(f"setup-config: could not run ansible-playbook: {exc}")
            return 127
    else:
        result = runner(cmd, cwd=str(repo_root), check=False)
        return result.returncode


TRISTATE_VALUES = (True, "ignore", False)


def cycle_tristate(value) -> object:
    """Cycle through tristate values: True -> ignore -> False -> True."""
    for i, v in enumerate(TRISTATE_VALUES):
        if v == value:
            return TRISTATE_VALUES[(i + 1) % len(TRISTATE_VALUES)]
    return TRISTATE_VALUES[0]  # Start at True for unexpected values


def status_label(value) -> str:
    """Return ON, SKIP, or OFF for tristate/bool values."""
    if value is True:
        return "ON"
    if value == "ignore":
        return "SKIP"
    if value is False:
        return "OFF"
    return str(value)


def list_label(key: str) -> str:
    """Map list key suffix to a human-readable label."""
    if key.endswith("_formulae"):
        return "Formulae"
    if key.endswith("_casks"):
        return "Casks"
    if key.endswith("_apt_packages"):
        return "Apt packages"
    if key.endswith("_taps"):
        return "Taps"
    if key == "agent_python_packages":
        return "Python packages"
    if key == "install_mas_apps":
        return "Install (MAS)"
    if key == "remove_mas_apps":
        return "Remove (MAS)"
    return "Packages"


def format_list(items) -> str:
    """Format a list of ListItem values."""
    if not items:
        return "(empty)"
    if isinstance(items, list):
        parts = []
        for item in items:
            if isinstance(item, ListItem):
                s = item.value
                if item.comment:
                    s += f" ({item.comment})"
                parts.append(s)
            else:
                parts.append(str(item))
        return ", ".join(parts)
    return "(unparsed)"


def expand_home_formula(value: str) -> str:
    """Expand {{ lookup('env', 'HOME') }} and ~ in a path string."""
    home = str(Path.home())
    result = HOME_FORMULA_RE.sub(home, value)
    if result.startswith("~/"):
        result = home + result[1:]
    return result


def normalize_venv_path(value: str) -> str:
    """Normalize a venv path: expand ~, reject relative paths."""
    value = value.strip()
    if not value:
        raise ToolError("empty venv path")
    expanded = expand_home_formula(value)
    if not os.path.isabs(expanded):
        raise ToolError(f"relative venv path: {value}")
    return os.path.normpath(expanded)


def save_venv_value(config, raw: str) -> bool:
    """Save a venv path, or reset to default if it matches."""
    normalized = normalize_venv_path(raw)
    default_expanded = expand_home_formula(str(config.defaults.get("agent_python_venv", "")))
    if normalized == default_expanded:
        return config.reset("agent_python_venv")
    return config.set("agent_python_venv", normalized)


def homebrew_available(which=shutil.which, is_executable=os.access) -> bool:
    """Check if homebrew is available."""
    if which("brew"):
        return True
    for path in ["/opt/homebrew/bin/brew", "/usr/local/bin/brew",
                 "/home/linuxbrew/.linuxbrew/bin/brew"]:
        if is_executable(path, os.X_OK):
            return True
    return False


def apt_available(which=shutil.which, is_executable=os.access) -> bool:
    """Check if apt is available."""
    if which("apt-get") or which("apt"):
        return True
    for path in ["/usr/bin/apt-get", "/usr/bin/apt"]:
        if is_executable(path, os.X_OK):
            return True
    return False


def is_editable(item, config) -> bool:
    """Check if an item's current value is editable."""
    eff = config.effective(item.key)
    if isinstance(eff, UnsupportedValue):
        return False
    if item.kind == "tristate":
        return isinstance(eff, (bool, str)) or eff is None
    default_val = config._defaults.get(item.key)
    if isinstance(default_val, bool):
        return isinstance(eff, bool)
    if isinstance(default_val, str):
        return isinstance(eff, str)
    return True


def item_badges(item, brew_available: bool, is_macos: bool, apt_available: bool = False) -> List[str]:
    """Return list of badge strings for an item."""
    badges = []
    if item.requires in ("homebrew", "darwin") and not brew_available:
        badges.append("needs Homebrew")
    if item.requires == "apt" and not apt_available:
        badges.append("needs apt")
    if item.requires == "darwin" and not is_macos:
        badges.append("macOS only")
    return badges


def describe_item(item, config, brew_available: bool, is_macos: bool, apt_available: bool = False) -> List[str]:
    """Return wrapped description lines for an item."""
    lines = []
    if item.summary:
        lines.append(item.summary)
    lines.append("")

    for key in item.lists:
        eff = config.effective(key)
        label = list_label(key)
        if isinstance(eff, list):
            formatted = format_list(eff)
        elif isinstance(eff, UnsupportedValue):
            formatted = "(unparsed)"
        else:
            formatted = str(eff) if eff is not None else "(empty)"
        lines.append(f"{label}: {formatted}")

    if item.extras:
        lines.append(f"Also: {', '.join(item.extras)}")

    eff = config.effective(item.key)
    src = config.source(item.key)
    if is_editable(item, config):
        lines.append(f"Value: {status_label(eff) if isinstance(eff, (bool, str)) else eff} ({src})")
    else:
        if isinstance(eff, UnsupportedValue):
            lines.append("Read-only: unsupported YAML structure.")
        else:
            lines.append("Read-only: value does not match the expected type.")

    for badge in item_badges(item, brew_available, is_macos, apt_available):
        lines.append(badge)

    return lines


def removal_summary(item, config) -> List[str]:
    """Return lines describing what would be removed when turning a group OFF."""
    lines = ["This group is set to OFF and will remove:"]
    for key in item.lists:
        eff = config.effective(key)
        label = list_label(key)
        if isinstance(eff, list):
            formatted = format_list(eff)
        else:
            formatted = str(eff) if eff is not None else "(empty)"
        lines.append(f"{label}: {formatted}")
    removals = item.removals or item.extras
    if removals:
        lines.append(f"Also: {', '.join(removals)}")
    if not item.lists and not (item.removals or item.extras):
        lines.append("No packages are currently listed for this group.")
    return lines



def run_tui(config, menu):
    """Interactive configuration UI built with prompt_toolkit."""
    # Imported lazily so --apply-now and the unit tests do not need uv.
    try:
        from prompt_toolkit import Application, prompt
        from prompt_toolkit.data_structures import Point
        from prompt_toolkit.key_binding import KeyBindings
        from prompt_toolkit.layout import (
            Dimension,
            HSplit,
            Layout,
            VSplit,
            Window,
            WindowAlign,
        )
        from prompt_toolkit.layout.controls import FormattedTextControl
        from prompt_toolkit.shortcuts import yes_no_dialog
        from prompt_toolkit.styles import Style
        from prompt_toolkit.widgets import Frame
    except ImportError:
        print(
            "setup-config: the interactive UI needs prompt_toolkit.\n"
            "Run ./setup-config (uv provisions it) or "
            "`uv run --script setup-config`.",
            file=sys.stderr,
        )
        return 2

    import time

    categories = menu.categories
    state = {"cat": 0, "item": 0, "status": "", "status_until": 0.0}
    brew = homebrew_available()
    apt = apt_available()
    macos = sys.platform == "darwin"

    badges = {}
    for category in categories:
        for entry in category.items:
            found = item_badges(entry, brew, macos, apt)
            if found:
                badges[entry.key] = found

    def current_items():
        if not categories:
            return ()
        return categories[state["cat"]].items

    def selected_item():
        options = current_items()
        if not options:
            return None
        state["item"] = max(0, min(state["item"], len(options) - 1))
        return options[state["item"]]

    def find_item(key):
        for category in categories:
            for entry in category.items:
                if entry.key == key:
                    return entry
        return None

    def notify(message, seconds=4.0):
        state["status"] = message
        state["status_until"] = time.monotonic() + seconds

    def header_text():
        return [("class:header", " Workstation Setup ")]

    def help_text():
        return [(
            "class:header",
            " \u2191\u2193 move  \u2190\u2192 category  Enter toggle  r reset  a apply  q quit ",
        )]

    def category_text():
        rendered = []
        for index, category in enumerate(categories):
            style = "class:selected" if index == state["cat"] else ""
            rendered.append((style, f" {category.label}"))
            if index < len(categories) - 1:
                rendered.append(("", "\n"))
        return rendered

    def category_cursor():
        return Point(x=0, y=state["cat"])

    def item_text():
        options = current_items()
        if not options:
            return [("class:dim", " No options in this category")]
        rendered = []
        for index, entry in enumerate(options):
            effective = config.effective(entry.key)
            if isinstance(effective, UnsupportedValue):
                shown = "unparsed"
            elif isinstance(effective, str):
                shown = status_label(effective)
                if entry.key == "agent_python_venv":
                    shown = Path(expand_home_formula(shown)).name or shown
                elif len(shown) > 20:
                    shown = shown[:19] + "\u2026"
            else:
                shown = status_label(effective)
            marker = "*" if config.source(entry.key) == "override" else " "
            line = f"{marker} {entry.label}  [{shown}]"
            if entry.key in badges:
                line += " !"
            style = "class:selected" if index == state["item"] else ""
            rendered.append((style, line))
            if index < len(options) - 1:
                rendered.append(("", "\n"))
        return rendered

    def item_cursor():
        options = current_items()
        if not options:
            return Point(x=0, y=0)
        return Point(x=0, y=max(0, min(state["item"], len(options) - 1)))

    def detail_text():
        entry = selected_item()
        if entry is None:
            return [("class:dim", " No option selected")]

        rendered = []

        def line(style="", text=""):
            rendered.append((style, text))
            rendered.append(("", "\n"))

        line("class:title", entry.label)
        if entry.summary:
            line(text=entry.summary)
            line()

        for key in entry.lists:
            value = config.effective(key)
            if isinstance(value, list):
                shown = format_list(value)
            elif isinstance(value, UnsupportedValue):
                shown = "(unparsed)"
            else:
                shown = str(value) if value is not None else "(empty)"
            line(text=f"{list_label(key)}: {shown}")

        if entry.extras:
            line(text=f"Also: {', '.join(entry.extras)}")

        line()
        effective = config.effective(entry.key)
        if is_editable(entry, config):
            shown = status_label(effective)
            if entry.key == "agent_python_venv" and isinstance(effective, str):
                shown = expand_home_formula(effective)
            line(text=f"Value: {shown} ({config.source(entry.key)})")
        elif isinstance(effective, UnsupportedValue):
            line("class:error", "Read-only: unsupported YAML structure.")
        else:
            line("class:error", "Read-only: value does not match the expected type.")

        if entry.key in badges:
            line()
            for badge in badges[entry.key]:
                line("class:warn", f"! {badge}")

        removals = entry.removals or entry.extras
        if entry.kind == "tristate" and effective is False:
            line()
            if entry.lists:
                line("class:warn", "OFF: removes the packages listed above.")
            else:
                line("class:warn", "OFF: no packages listed for this group.")
            if removals:
                line("class:warn", "Also removes: " + ", ".join(removals))
        elif entry.kind == "tristate" and removals:
            line()
            line("class:warn", "OFF removes: " + ", ".join(removals))

        line()
        if entry.kind == "bool":
            line("class:dim", "[Enter] toggle   [r] reset")
        elif entry.kind == "tristate":
            line("class:dim", "[Enter] cycle ON/SKIP/OFF   [r] reset")
        else:
            line("class:dim", "[Enter] edit   [r] reset")
        return rendered

    def footer_text():
        if state["status"] and time.monotonic() < state["status_until"]:
            return [("class:status", " " + state["status"])]
        return [("class:footer", " Select an option and press Enter.  * = local override")]

    style = Style.from_dict({
        "header": "bg:#005f87 #ffffff bold",
        "footer": "bg:#262626 #c6c6c6",
        "status": "bg:#262626 #ffd75f bold",
        "selected": "bg:#5f8787 #000000 bold",
        "title": "#5fd7ff bold",
        "warn": "#ffd75f",
        "error": "#ff5f5f bold",
        "dim": "#9e9e9e",
        "frame.border": "#5f8787",
        "frame.label": "#5fd7d7 bold",
    })

    def build_app():
        key_bindings = KeyBindings()

        def move_item(delta):
            options = current_items()
            if options:
                state["item"] = max(0, min(state["item"] + delta, len(options) - 1))

        def move_category(delta):
            if categories:
                state["cat"] = max(0, min(state["cat"] + delta, len(categories) - 1))
                state["item"] = 0

        @key_bindings.add("q")
        @key_bindings.add("c-c")
        @key_bindings.add("c-q")
        def _quit(event):
            event.app.exit(result=("quit",))

        @key_bindings.add("up")
        @key_bindings.add("k")
        def _up(event):
            move_item(-1)

        @key_bindings.add("down")
        @key_bindings.add("j")
        def _down(event):
            move_item(1)

        @key_bindings.add("pageup")
        def _page_up(event):
            move_item(-5)

        @key_bindings.add("pagedown")
        def _page_down(event):
            move_item(5)

        @key_bindings.add("left")
        @key_bindings.add("h")
        def _left(event):
            move_category(-1)

        @key_bindings.add("right")
        @key_bindings.add("l")
        def _right(event):
            move_category(1)

        @key_bindings.add("enter")
        @key_bindings.add("space")
        def _activate(event):
            entry = selected_item()
            if entry is None:
                return
            if not is_editable(entry, config):
                notify(f"{entry.label}: read-only")
                return
            if entry.kind == "string":
                event.app.exit(result=("edit", entry.key))
                return
            try:
                if entry.kind == "tristate":
                    new_value = cycle_tristate(config.effective(entry.key))
                else:
                    new_value = not bool(config.effective(entry.key))
                changed = config.set(entry.key, new_value)
                label = status_label(new_value)
                notify(f"{entry.label}: {label}" if changed else f"{entry.label} already {label}")
            except ToolError as exc:
                notify(f"Error: {exc}", 6.0)

        @key_bindings.add("r")
        def _reset(event):
            entry = selected_item()
            if entry is None:
                return
            try:
                changed = config.reset(entry.key)
                notify(
                    f"{entry.label}: reset to default"
                    if changed else f"{entry.label} already at default"
                )
            except ToolError as exc:
                notify(f"Error: {exc}", 6.0)

        @key_bindings.add("a")
        def _apply(event):
            event.app.exit(result=("apply",))

        body = VSplit(
            [
                Frame(
                    Window(
                        FormattedTextControl(
                            text=category_text,
                            show_cursor=False,
                            get_cursor_position=category_cursor,
                        ),
                        wrap_lines=False,
                    ),
                    title="Categories",
                    width=Dimension(weight=3, min=18),
                ),
                Frame(
                    Window(
                        FormattedTextControl(
                            text=item_text,
                            focusable=True,
                            show_cursor=False,
                            get_cursor_position=item_cursor,
                        ),
                        wrap_lines=False,
                    ),
                    title="Options",
                    width=Dimension(weight=7, min=32),
                ),
                Frame(
                    Window(
                        FormattedTextControl(text=detail_text, show_cursor=False),
                        wrap_lines=True,
                    ),
                    title="Details",
                    width=Dimension(weight=8, min=24),
                ),
            ],
            padding=1,
            height=Dimension(weight=1),
            window_too_small=Window(
                FormattedTextControl(
                    text=" Terminal too small. Resize to at least 80 columns.",
                    show_cursor=False,
                ),
                align=WindowAlign.CENTER,
                style="class:error",
            ),
        )

        layout = Layout(
            HSplit(
                [
                    VSplit(
                        [
                            Window(
                                FormattedTextControl(text=header_text, show_cursor=False),
                                height=1,
                                style="class:header",
                            ),
                            Window(
                                FormattedTextControl(text=help_text, show_cursor=False),
                                height=1,
                                style="class:header",
                                align=WindowAlign.RIGHT,
                            ),
                        ],
                        height=1,
                    ),
                    body,
                    Window(
                        FormattedTextControl(text=footer_text, show_cursor=False),
                        height=1,
                        style="class:footer",
                    ),
                ],
                height=Dimension(weight=1),
            )
        )

        return Application(
            layout=layout,
            key_bindings=key_bindings,
            style=style,
            full_screen=True,
            refresh_interval=0.5,
        )

    try:
        while True:
            result = build_app().run()
            if not result or result[0] == "quit":
                return 0
            if result[0] == "apply":
                confirmed = yes_no_dialog(
                    title="Apply playbook",
                    text="Run the Ansible playbook now?",
                ).run()
                if not confirmed:
                    notify("Apply cancelled.")
                    continue
                use_become = False
                if become_prompt_required(apt):
                    use_become = become_choice_confirmed(
                        yes_no_dialog(
                            title="Allow system changes?",
                            text=(
                                "The Debian/Ubuntu package tasks need sudo. You "
                                "will be prompted for your password. Choose No "
                                "to skip them."
                            ),
                        ).run()
                    )
                code = apply_playbook(REPO_ROOT, ask_become_pass=use_become)
                if code != 0:
                    notify(f"Playbook exited with status {code}.", 8.0)
                elif apt and not use_become:
                    notify("Applied without sudo; package tasks were skipped.", 8.0)
                else:
                    notify("Playbook applied successfully.", 6.0)
                continue
            if result[0] == "edit":
                entry = find_item(result[1])
                if entry is None:
                    continue
                current = config.effective(entry.key)
                if entry.key == "agent_python_venv" and isinstance(current, str):
                    default = expand_home_formula(current)
                else:
                    default = "" if current is None else str(current)
                try:
                    value = prompt(f" {entry.label}: ", default=default)
                except (EOFError, KeyboardInterrupt):
                    notify("Edit cancelled.")
                    continue
                try:
                    if entry.key == "agent_python_venv":
                        changed = save_venv_value(config, value)
                    else:
                        changed = config.set(entry.key, value)
                    notify(
                        f"{entry.label}: saved"
                        if changed else f"{entry.label}: unchanged"
                    )
                except ToolError as exc:
                    notify(f"Error: {exc}", 6.0)
                continue
    except KeyboardInterrupt:
        return 130
    except Exception as exc:
        print(f"setup-config: TUI error: {exc}", file=sys.stderr)
        return 1


def main(argv=None):
    """Main entry point."""
    # Check Python version
    if sys.version_info < (3, 8):
        print("setup-config: Python 3.8 or newer is required.", file=sys.stderr)
        return 1

    import argparse
    parser = argparse.ArgumentParser(prog="setup-config")
    parser.add_argument("--apply-now", action="store_true",
                        help="Apply the playbook without opening the TUI")
    parser.add_argument("--ask-become-pass", action="store_true",
                        help="Prompt for a sudo password so apt tasks can run")
    args = parser.parse_args(argv)

    if args.ask_become_pass and not args.apply_now:
        parser.error("--ask-become-pass requires --apply-now")

    if args.apply_now:
        if not args.ask_become_pass and apt_available():
            print(
                "setup-config: note: apt tasks will be skipped; pass "
                "--ask-become-pass to install packages.",
                file=sys.stderr,
            )
        return apply_playbook(REPO_ROOT, ask_become_pass=args.ask_become_pass)

    # Check for TTY
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("setup-config: interactive mode requires a terminal. "
              "Use --apply-now for non-interactive apply.", file=sys.stderr)
        return 2

    # Load defaults and menu
    try:
        defaults = parse_yaml_subset(DEFAULT_CONFIG.read_text())
        menu = load_menu(MENU_FILE, defaults)
        tristate_keys = {
            item.key
            for category in menu.categories
            for item in category.items
            if item.kind == "tristate"
        }
        config = Config(DEFAULT_CONFIG, PREFERENCES, menu.package_keys, tristate_keys)
    except (OSError, ToolError) as e:
        print(f"setup-config: {e}", file=sys.stderr)
        return 1

    return run_tui(config, menu)


if __name__ == "__main__":
    sys.exit(main())
