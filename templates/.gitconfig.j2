[core]
	excludesFile = ~/.gitignore
[pull]
	ff = true
[push]
	default = simple
	autoSetupRemote = true
[pager]
	branch = false
	diff = false
{% if gh_path.rc == 0 %}
{# The empty "helper =" resets the helper list inherited from the system gitconfig (Homebrew's
   osxkeychain), which would otherwise answer first with a stored login and bypass gh and
   GITHUB_TOKEN (e.g. a per-directory direnv token). #}
[credential "https://github.com"]
	helper =
	helper = !{{ gh_path.stdout }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ gh_path.stdout }} auth git-credential
{% endif %}
{% if ansible_facts.os_family == 'Windows'%}
[credential]
	helper = manager
	credentialStore = wincredman
{% elif gcm_path.rc == 0 %}
[credential]
	helper = {{ gcm_path.stdout }}
{% if ansible_facts.os_family == 'Darwin' %}
	credentialStore = keychain
{% else %}
	credentialStore = secretservice
{% endif %}
{% endif %}
