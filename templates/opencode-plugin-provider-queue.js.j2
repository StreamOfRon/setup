// provider-queue - opt-in per-provider/per-model request serialization for OpenCode.
//
// Self-hosted LLM backends that can only process one generation at a time
// (a single-GPU vLLM/LiteLLM/Tiiny box) degrade badly under concurrency:
// simultaneous streams evict each other's prompt caches and time out. This
// plugin queues model HTTP requests so a configured provider or model sees a
// bounded number of in-flight requests (1 = strictly serial), while every
// other provider keeps OpenCode's default behavior.
//
// Activation is opt-in via the normal provider/model config stanzas:
//
//   "providers": {
//     "tiiny-local": { "settings": { "concurrency": 1, ... } },        // per provider
//     "litellm": {
//       "models": {
//         "qwen3.8-27b": { "settings": { "concurrency": 1 }, ... }     // per model wins
//       }
//     }
//   }
//
// OpenCode's provider registry drops unknown keys from `settings` before
// plugins can read them, so this plugin parses the config documents directly,
// walking the documented discovery chain (global -> project ancestors ->
// system directory; managed preferences are not read). A model-level value
// overrides the provider-level one; `null` clears an inherited value.
//
// Mechanics:
//   - "http.request" hook awaits a FIFO ticket for the request's queue before
//     the request is dispatched.
//   - "http.response" hook wraps the response body stream and releases the
//     ticket when the stream ends, errors, or is cancelled, so a slot is held
//     for the whole generation, not just until headers arrive.
//   - "retry" hook releases tickets of attempts that failed before a response
//     body existed.
//   - A lease watchdog force-releases any ticket older than 15 minutes so a
//     lost stream can never deadlock the queue.
//
// Queues are module-scope state: OpenCode loads plugins per location but the
// server is a single process, so parent sessions, subagents, and separate
// projects all share one queue per key. Requires a V2-native provider package
// (e.g. "@opencode/ai/providers/openai-compatible"); the deprecated
// "aisdk:" runtime does not route through these HTTP hooks.
//
// Queue activity is appended to ~/.local/share/opencode/log/provider-queue.log
// because plugin stdout is not captured by the detached OpenCode service.
// Setting OPENCODE_PROVIDER_QUEUE_DEBUG=1 logs every intercepted request.

import { appendFileSync, readFileSync, statSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join, parse as parsePath, resolve } from "node:path";
import { Plugin } from "@opencode/plugin";

const LEASE_MS = 15 * 60 * 1000;
const MODEL_KINDS = new Set(["primary", "compaction", "title", "generate"]);
const LOG_PATH = join(homedir(), ".local", "share", "opencode", "log", "provider-queue.log");
const CONFIG_TTL_MS = 5000;
const DEBUG = process.env.OPENCODE_PROVIDER_QUEUE_DEBUG === "1";

function log(message) {
  const line = `${new Date().toISOString()} ${message}`;
  console.log(`[provider-queue] ${message}`);
  try {
    appendFileSync(LOG_PATH, `${line}\n`);
  } catch {
    // logging must never break request handling
  }
}

// ---- config discovery --------------------------------------------------------

function configDirCandidates(baseDirectory) {
  return [join(baseDirectory, "opencode.json"), join(baseDirectory, "opencode.jsonc")];
}

function globalConfigDirectory() {
  const xdg = process.env.XDG_CONFIG_HOME;
  return xdg ? join(xdg, "opencode") : join(homedir(), ".config", "opencode");
}

function systemConfigDirectory() {
  if (process.platform === "darwin") return join("/Library/Application Support", "opencode");
  if (process.platform === "win32") return join(process.env.ProgramData || "C:\\ProgramData", "opencode");
  return "/etc/opencode";
}

// Files in ascending precedence: OpenCode merges direct opencode.json(c) from
// the farthest ancestor to the current directory, then does the same for
// .opencode/opencode.json(c), so every .opencode config overrides every
// direct one; global is lowest, system highest.
function configFilesFor(locationDirectory) {
  const files = [];
  const projectChain = [];
  let dir = resolve(locationDirectory);
  const root = parsePath(dir).root;
  for (;;) {
    projectChain.unshift(dir);
    if (dir === root) break;
    dir = dirname(dir);
  }
  files.push(...configDirCandidates(globalConfigDirectory()));
  for (const projectDir of projectChain) files.push(...configDirCandidates(projectDir));
  for (const projectDir of projectChain) {
    files.push(...configDirCandidates(join(projectDir, ".opencode")));
  }
  files.push(...configDirCandidates(systemConfigDirectory()));
  return files;
}

// Tolerant JSONC parse: strip comments outside strings, drop trailing commas.
function parseJsonc(text) {
  try {
    return JSON.parse(text);
  } catch {
    // fall through to a lenient pass
  }
  let out = "";
  let inString = false;
  let inLine = false;
  let inBlock = false;
  for (let i = 0; i < text.length; i += 1) {
    const ch = text[i];
    const next = text[i + 1];
    if (inLine) {
      if (ch === "\n") {
        inLine = false;
        out += ch;
      }
      continue;
    }
    if (inBlock) {
      if (ch === "*" && next === "/") {
        inBlock = false;
        i += 1;
      }
      continue;
    }
    if (inString) {
      out += ch;
      if (ch === "\\") {
        out += next ?? "";
        i += 1;
      } else if (ch === '"') inString = false;
      continue;
    }
    if (ch === '"') {
      inString = true;
      out += ch;
    } else if (ch === "/" && next === "/") {
      inLine = true;
      i += 1;
    } else if (ch === "/" && next === "*") {
      inBlock = true;
      i += 1;
    } else {
      out += ch;
    }
  }
  out = out.replace(/,\s*([}\]])/g, "$1");
  return JSON.parse(out);
}

const parseConcurrency = (value) => {
  if (value === null) return null; // explicit clear
  const n = Number(value);
  return Number.isFinite(n) && n >= 1 ? Math.floor(n) : undefined;
};

const configCache = new Map(); // file path -> { mtimeMs, doc, error }

function readConfigFile(pathString) {
  let stat;
  try {
    stat = statSync(pathString);
  } catch {
    configCache.delete(pathString);
    return undefined;
  }
  let entry = configCache.get(pathString);
  if (!entry || entry.mtimeMs !== stat.mtimeMs || Date.now() - (entry.checked ?? 0) > CONFIG_TTL_MS) {
    entry = { mtimeMs: stat.mtimeMs, checked: Date.now() };
    try {
      entry.doc = parseJsonc(readFileSync(pathString, "utf8"));
    } catch (error) {
      entry.error = error.message;
    }
    configCache.set(pathString, entry);
  }
  if (entry.error) {
    log(`skipping ${pathString}: ${entry.error}`);
    return undefined;
  }
  return entry.doc;
}

// location directory -> { at, providers: Map, models: Map }
const limitsCache = new Map();

function limitsFor(locationDirectory) {
  const cached = limitsCache.get(locationDirectory);
  if (cached && Date.now() - cached.at < CONFIG_TTL_MS) return cached;
  const providers = new Map();
  const models = new Map();
  for (const file of configFilesFor(locationDirectory)) {
    const doc = readConfigFile(file);
    const providerStanzas = doc && doc.providers;
    if (!providerStanzas || typeof providerStanzas !== "object") continue;
    for (const [providerID, stanza] of Object.entries(providerStanzas)) {
      if (!stanza || typeof stanza !== "object") continue;
      const providerLimit = stanza.settings ? parseConcurrency(stanza.settings.concurrency) : undefined;
      if (providerLimit === null) providers.delete(providerID);
      else if (providerLimit !== undefined) providers.set(providerID, providerLimit);
      const modelStanzas = stanza.models;
      if (!modelStanzas || typeof modelStanzas !== "object") continue;
      for (const [modelID, modelStanza] of Object.entries(modelStanzas)) {
        const modelLimit =
          modelStanza && modelStanza.settings ? parseConcurrency(modelStanza.settings.concurrency) : undefined;
        const key = `${providerID}/${modelID}`;
        if (modelLimit === null) models.delete(key);
        else if (modelLimit !== undefined) models.set(key, modelLimit);
      }
    }
  }
  const result = { at: Date.now(), providers, models };
  limitsCache.set(locationDirectory, result);
  return result;
}

// ---- queue -------------------------------------------------------------------

/**
 * @typedef {Object} Queue
 * @property {string} key
 * @property {number} limit
 * @property {number} active
 * @property {Array.<function()>} waiters
 * @property {Array.<Object>} held
 */

/** @type {Map<string, Queue>} */
const queues = new Map();

function queueFor(key, limit) {
  let q = queues.get(key);
  if (!q) {
    q = { key, limit, active: 0, waiters: [], held: [] };
    queues.set(key, q);
  } else if (q.limit !== limit) {
    q.limit = limit; // relaxed or tightened; takes effect as slots free up
  }
  return q;
}

function acquire(q) {
  return new Promise((resolve2) => {
    const grant = () => {
      const ticket = { done: false, sawResponse: false, timer: null };
      ticket.timer = setTimeout(() => {
        if (!ticket.done) {
          log(`${q.key}: lease expired, releasing a stuck slot`);
          release(q, ticket);
        }
      }, LEASE_MS);
      q.active += 1;
      q.held.push(ticket);
      resolve2(ticket);
    };
    if (q.active < q.limit) grant();
    else q.waiters.push(grant);
  });
}

function release(q, ticket) {
  if (ticket.done) return;
  ticket.done = true;
  clearTimeout(ticket.timer);
  const i = q.held.indexOf(ticket);
  if (i >= 0) q.held.splice(i, 1);
  q.active = Math.max(0, q.active - 1);
  const next = q.waiters.shift();
  if (next) next();
}

// The hooks do not expose which request a response belongs to, so the queue
// binds responses to the oldest still-open ticket. Every successful response
// releases exactly one ticket, so the slot count stays correct even for limits
// above 1; a mismatch only ever shifts which stream owns a slot.
function openTicket(q, { excludeResponded } = {}) {
  return q.held.find((t) => !t.done && (!excludeResponded || !t.sawResponse));
}

function selectQueue(limits, model) {
  if (!model || !model.providerID || !model.id) return undefined;
  const modelLimit = limits.models.get(`${model.providerID}/${model.id}`);
  if (modelLimit !== undefined) return { key: `${model.providerID}/${model.id}`, limit: modelLimit };
  const providerLimit = limits.providers.get(model.providerID);
  if (providerLimit !== undefined) return { key: `${model.providerID}/*`, limit: providerLimit };
  return undefined;
}

export default Plugin.define({
  id: "provider-queue",
  async setup(ctx) {
    const locationDirectory = ctx.location?.directory ?? process.cwd();
    const sessionSelections = new Map(); // sessionID -> sel (fallback when a hook lacks model)

    // Fallback for hook events that omit `model` entirely; an event whose
    // model resolves to no queue is genuinely unqueued and must not inherit
    // the session's last queued selection.
    const selectionFor = (event) => {
      const direct = selectQueue(limitsFor(locationDirectory), event.model);
      if (direct) return direct;
      return event.model ? undefined : sessionSelections.get(event.sessionID);
    };

    await ctx.session.hook("http.request", async (event) => {
      if (!MODEL_KINDS.has(event.kind)) return;
      const sel = selectQueue(limitsFor(locationDirectory), event.model);
      if (DEBUG) log(`DEBUG http.request kind=${event.kind} model=${JSON.stringify(event.model)} queued=${sel ? sel.key : "no"}`);
      if (!sel) return;
      const q = queueFor(sel.key, sel.limit);
      sessionSelections.set(event.sessionID, sel);
      const started = Date.now();
      if (q.active >= q.limit || q.waiters.length > 0) {
        log(`${q.key}: request waiting (in flight=${q.active}/${q.limit}, queued=${q.waiters.length})`);
      }
      await acquire(q);
      const waited = Date.now() - started;
      if (waited > 0) {
        log(`${q.key}: slot acquired after ${waited}ms wait (in flight=${q.active}/${q.limit}, queued=${q.waiters.length})`);
      }
    });

    await ctx.session.hook("http.response", (event) => {
      if (!MODEL_KINDS.has(event.kind)) return;
      const sel = selectionFor(event);
      if (!sel) return;
      const q = queues.get(sel.key);
      if (!q) return;
      const ticket = openTicket(q);
      if (!ticket) return;
      const body = event.response && event.response.body;
      if (!body) {
        release(q, ticket);
        return;
      }
      ticket.sawResponse = true;
      const done = () => release(q, ticket);
      const reader = body.getReader();
      event.response = new Response(
        new ReadableStream({
          pull(controller) {
            return reader.read().then(
              ({ done: finished, value }) => {
                if (finished) {
                  done();
                  controller.close();
                } else {
                  controller.enqueue(value);
                }
              },
              (error) => {
                done();
                controller.error(error);
              },
            );
          },
          cancel(reason) {
            done();
            return reader.cancel(reason);
          },
        }),
        {
          status: event.response.status,
          statusText: event.response.statusText,
          headers: event.response.headers,
        },
      );
    });

    await ctx.session.hook("retry", (event) => {
      const sel = selectionFor(event);
      if (!sel) return;
      const q = queues.get(sel.key);
      if (!q) return;
      // Tickets whose stream already started release themselves when the
      // stream terminates; only reclaim slots from attempts that never got a
      // response body.
      const ticket = openTicket(q, { excludeResponded: true });
      if (ticket) {
        log(`${q.key}: releasing slot for failed attempt ${event.attempt}`);
        release(q, ticket);
      }
    });

    const limits = limitsFor(locationDirectory);
    log(
      `loaded for ${locationDirectory} providers=[${[...limits.providers].map(([k, v]) => `${k}:${v}`).join(", ")}] ` +
        `models=[${[...limits.models].map(([k, v]) => `${k}:${v}`).join(", ")}]`,
    );
  },
});
