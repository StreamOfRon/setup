    - twg
    - twg-agentic-search
    - twg-artifacts
    - twg-code-review
    - twg-confluence
    - twg-context-discovery
    - twg-engineering-work
    - twg-jira
    - twg-jira-resolve-merged-work
    - twg-operational-health
    - twg-responsibility-routing
    - twg-space-creation
    - twg-status-rollups
autolearn:
  enabled: false
modelPresets:
  local-first:
    modelRoles:
      tiny: apple/on-device
      smol: apple/on-device
      default: litellm/llamaswap/thinkingcap-qwen3.8-27b
