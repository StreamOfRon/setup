setupVersion: 2
modelRoles:
  tiny: apple/on-device
  smol: apple/on-device
  plan: opencode-go/kimi-k3:auto
  web: web/searxng
  default: litellm/llamaswap/thinkingcap-qwen3.8-27b
  task: litellm/llamaswap/qwen3.6-35b-a3b
providers:
  maxInFlightRequests:
    litellm: 1
  tinyModelDevice: mlx
  tinyModelDtype: default
searxng:
  endpoint: https://searxng.int.cshome.link
astEdit:
  enabled: false
debug:
  enabled: false
github:
  enabled: true
ida:
  enabled: false
bash:
  direnv: auto
  patterns:
    - match: "kubectl-readonly *"
      approval: allow
    - match: "kubectl-readonly"
      approval: allow
    - match: "kubectl readonly *"
      approval: allow
    - match: "kubectl readonly"
      approval: allow
    - match: "kubectl kustomize *"
      approval: allow
    - match: "kubectl kustomize"
      approval: allow
    - match: "kubectl *"
      approval: prompt
    - match: "kubectl"
      approval: prompt
bashInterceptor:
  enabled: false
memory:
  backend: local
defaultThinkingLevel: auto
hideThinkingBlock: false
composer:
  shape: rule
  tokenRate: true
statusLine:
  preset: nerd
display:
  subagentLivePreview: true
edit:
  mode: hashline
inlineToolDescriptors: auto
browser:
  headless: true
plan:
  autosave: true
worktree:
  onExit: remove
skills:
