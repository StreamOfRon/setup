export PATH="/usr/local/sbin:$PATH"
export PATH="/usr/local/opt/mysql-client/bin:$PATH"
export PATH="$PATH:$HOME/bin"
export PATH="$HOME/.local/bin:$PATH"
# Put `go install` binaries in ~/.local/bin (already on PATH above) instead
# of the default $GOPATH/bin, so no extra PATH entry is needed.
export GOPATH="${GOPATH:-$HOME/go}"
export GOBIN="$HOME/.local/bin"
{% if install_dev_cli_tools | default(false) != false %}
# Rust toolchain (rustup) installs cargo/rustc into ~/.local/bin; keep its
# homes under ~/.local so no separate cargo bin PATH entry is needed.
export RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.local/share/rustup}"
export CARGO_HOME="${CARGO_HOME:-$HOME/.local}"
{% endif %}
if [[ -d "$HOME/.krew/bin" ]]; then
  export PATH="$PATH:$HOME/.krew/bin"
fi
if [[ -d "$HOME/.local/share/default-venv/bin" ]]; then
  export PATH="$HOME/.local/share/default-venv/bin:$PATH"
fi
{# Rendered unless the group is actively off; runtime guards make stray lines harmless #}
{% if install_ai_dev_tools | default(false) != false %}
export PATH="$HOME/.opencode/bin:$PATH"
{% endif %}

[[ ! -f ~/.zshrc.omz ]] || source ~/.zshrc.omz

# Set it here, so it can be overridden in zshrc.local
export EDITOR='vim'
setopt AUTO_CD
setopt GLOB_STAR_SHORT
setopt NO_NOMATCH
setopt GLOB_DOTS
setopt EXTENDED_GLOB
unsetopt CASE_GLOB

run-workflow() {
  gh workflow run $1 --ref $(git rev-parse --abbrev-ref HEAD)
  sleep 5
  watch-workflow $1
}
watch-workflow() {
  gh run watch $(gh run ls -c $(git rev-parse HEAD) --workflow="$1" --json databaseId -q '.[0].databaseId')
}

{% if install_ai_dev_tools | default(false) != false %}
# worktrunk shell integration (herdr worktree workflow)
if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi
{% endif %}

[[ ! -f ~/.zshrc.local ]] || source ~/.zshrc.local
